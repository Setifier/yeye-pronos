async function main() {
  console.log("🏆 Seed des badges NBA Pronos\n");
  console.log(`📊 Total de badges à créer : ${badges.length}\n`);

  let created = 0;
  let skipped = 0;

  for (const badge of badges) {
    try {
      // Vérifier si le badge existe déjà
      const existing = await prisma.badge.findUnique({
        where: { slug: badge.slug },
      });

      if (existing) {
        console.log(`⏭️  Badge déjà existant : ${badge.name}`);
        skipped++;
        continue;
      }

      // Créer le badge
      await prisma.badge.create({
        data: {
          slug: badge.slug,
          name: badge.name,
          description: badge.description,
          icon: badge.icon,
          type: badge.type,
          category: badge.category,
          rarity: badge.rarity,
          difficultyLevel: badge.difficultyLevel,
          points: 0, // Pas de points pour l'instant
          reward: badge.reward,
          criteria: badge.criteria,
        },
      });

      created++;
      console.log(`✅ Badge créé : ${badge.name} (${badge.category})`);
    } catch (error) {
      console.error(`❌ Erreur pour ${badge.name}:`, error);
    }
  }

  console.log("\n" + "=".repeat(60));
  console.log(`📊 Résumé :`);
  console.log(`   ✅ Badges créés : ${created}`);
  console.log(`   ⏭️  Badges déjà existants : ${skipped}`);
  console.log("=".repeat(60) + "\n");

  // Statistiques par catégorie
  const seasonBadges = badges.filter((b) => b.category === "SEASON").length;
  const endSeasonBadges = badges.filter((b) => b.category === "END_SEASON").length;
  const careerBadges = badges.filter((b) => b.category === "CAREER").length;

  console.log("📊 Répartition :");
  console.log(`   🏀 Badges Accomplissement (Saison) : ${seasonBadges}`);
  console.log(`   🏆 Badges Fin de Saison : ${endSeasonBadges}`);
  console.log(`   💎 Badges Carrière : ${careerBadges}`);
  console.log("");
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
