generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELLED
}

enum Conference {
  EAST
  WEST
}

enum PredictionResult {
  PENDING
  WON
  LOST
  CANCELLED
}

enum BugReportStatus {
  OPEN
  RESOLVED
}


// ============================================
// AUTH (Better-Auth compatible)
// ============================================

model User {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  friendCode    String?   @unique

  // Onboarding fields
  hasCompletedOnboarding Boolean   @default(false)
  favoriteTeamId         String?
  favoriteTeam           Team?     @relation("UserFavoriteTeam", fields: [favoriteTeamId], references: [id])
  favoritePlayerId       String?
  favoritePlayer         Player?   @relation("UserFavoritePlayer", fields: [favoritePlayerId], references: [id])

  role          UserRole  @default(USER)
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  sessions               Session[]
  accounts               Account[]
  predictions            Prediction[]
  specialPredictions     SpecialPrediction[]
  ownedLeagues           PrivateLeague[]       @relation("LeagueOwner")
  leagueMemberships      LeagueMember[]
  sentFriendRequests     FriendRequest[]       @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]       @relation("FriendRequestReceiver")
  bugReports             BugReport[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  identifier String
  value      String
  expiresAt  DateTime

  @@map("verifications")
}

// ============================================
// NBA DATA (synced from external API)
// ============================================

model Team {
  id            String     @id @default(uuid())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  externalId    String     @unique
  name          String
  city          String
  abbreviation  String     @unique
  conference    Conference
  division      String
  logoUrl       String?
  primaryColor  String?    // Couleur principale de l'équipe (hex)
  secondaryColor String?   // Couleur secondaire de l'équipe (hex)

  homeGames     Game[]     @relation("HomeTeam")
  awayGames     Game[]     @relation("AwayTeam")
  players       Player[]
  playerStats   GamePlayerStats[]
  seasonStats   TeamSeasonStats[]
  favoritedBy   User[]     @relation("UserFavoriteTeam")
  seriesAsTeam1 PlayoffSeries[] @relation("SeriesTeam1")
  seriesAsTeam2 PlayoffSeries[] @relation("SeriesTeam2")

  @@map("teams")
}

model Player {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  externalId    String    @unique
  firstName     String
  lastName      String
  fullName      String    // "LeBron James" pour recherche facile
  position      String?
  jerseyNumber  String?

  // Physical info
  height        String?   // "6-9" (feet-inches)
  weight        String?   // "250" (pounds)
  heightMetric  String?   // "2.06" (mètres)
  weightMetric  String?   // "113" (kg)

  // Background
  college       String?   // "St. Vincent-St. Mary HS (OH)"
  country       String?   // "USA"

  // Photo
  headshot      String?   // URL du headshot du joueur

  // Contrat
  contractType  String?   // "standard", "two-way", "10-day"

  // Infirmerie
  isInjured     Boolean   @default(false)
  injuryStatus  String?   // "Out", "Day-to-Day", "Questionable"
  injuryNote    String?   // "Ankle sprain"
  injuryReturnDate DateTime? // Date estimée de retour

  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])

  // Relations
  gameStats              GamePlayerStats[]
  seasonStats            PlayerSeasonStats[]
  injuryReports          InjuryReport[]
  predictionsAsTopScorer Prediction[]      @relation("PredictionTopScorer")
  gamesAsTopScorer       Game[]            @relation("GameTopScorer")
  favoritedBy            User[]            @relation("UserFavoritePlayer")
  awardResults           SeasonAwardResult[]

  @@index([teamId])
  @@index([fullName])
  @@map("players")
}

model Game {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  externalId    String      @unique
  season        String
  seasonType    String
  gameDate      DateTime    // Heure UTC (pour calculs et affichage précis)
  localGameDate DateTime    // Date/heure locale de l'équipe qui reçoit (pour recherche par jour)
  status        GameStatus  @default(SCHEDULED)

  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeScore     Int?

  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayScore     Int?

  winnerId      String?

  // 🆕 Bonus Points - Meilleur marqueur du match
  topScorerId   String?
  topScorer     Player?     @relation("GameTopScorer", fields: [topScorerId], references: [id])
  topScorerPoints Int?      // Nombre de points du top scorer

  // 🆕 Bonus Points - Catégorie d'écart
  scoreMarginCategory String? // "OVERTIME", "MATCH_SERRE", "UN_CLASSIQUE", etc.
  actualScoreMargin   Int?    // Écart réel de points

  // 🆕 Infos prolongation
  hasOvertime   Boolean     @default(false)
  overtimePeriods Int?      // Nombre de prolongations

  // 🆕 Infos temps réel (pour matchs LIVE)
  currentPeriod Int?        // Quart-temps actuel (1-4, >4 = OT)
  gameClock     String?     // Temps restant "5:30"

  // 🆕 Playoffs
  isIfNecessary Boolean     @default(false) // Game 5/6/7 conditionnel
  seriesId      String?
  series        PlayoffSeries? @relation(fields: [seriesId], references: [id])
  gameNumber    Int?              // Game 1, 2, 3... au sein de la série

  // 🆕 NBA Cup (In-Season Tournament)
  nbaCupRound   String?     // "GroupPlay" | "Quarterfinal" | "Semifinal" | "Championship"
  nbaCupGroup   String?     // "East-A" | "East-B" | "East-C" | "West-A" | "West-B" | "West-C"

  predictionDeadline DateTime

  predictions   Prediction[]
  playerStats   GamePlayerStats[]

  @@index([gameDate])
  @@index([localGameDate])
  @@index([season])
  @@index([status])
  @@index([seriesId])
  @@index([nbaCupRound])
  @@map("games")
}

// ============================================
// USER PREDICTIONS & SCORING
// ============================================

model Prediction {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameId          String
  game            Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)

  predictedTeamId String

  result          PredictionResult @default(PENDING)
  pointsEarned    Int              @default(0)

  // 🆕 BONUS POINTS - Écart de score
  predictedScoreMargin  String?  // Catégorie prédite : "OVERTIME", "MATCH_SERRE", etc.
  marginBonusPoints     Int      @default(0) // 0 ou 5 pts

  // 🆕 BONUS POINTS - Meilleur marqueur
  predictedTopScorerId  String?
  predictedTopScorer    Player?  @relation("PredictionTopScorer", fields: [predictedTopScorerId], references: [id])
  topScorerBonusPoints  Int      @default(0) // 0 ou 5 pts

  // 🆕 BONUS POINTS - Combo parfait (prono + écart + top scorer)
  comboBonusPoints      Int      @default(0) // 0 ou 10 pts

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@map("predictions")
}

// ============================================
// PLAYER STATS & INJURY TRACKING
// ============================================

model GamePlayerStats {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])

  // Stats basiques (récupérées depuis ESPN API)
  points      Int
  rebounds    Int?
  assists     Int?
  steals      Int?
  blocks      Int?
  turnovers   Int?
  minutes     String?  // Format "32:45"

  // Shooting
  fieldGoalsMade      Int?
  fieldGoalsAttempted Int?
  threePointersMade   Int?
  threePointersAttempted Int?
  freeThrowsMade      Int?
  freeThrowsAttempted Int?

  // Rebonds offensifs / défensifs
  offensiveRebounds   Int?
  defensiveRebounds   Int?

  // Advanced stats
  plusMinus           Int?     // +/- when player is on court
  personalFouls       Int?     // Fautes personnelles

  @@unique([gameId, playerId])
  @@index([gameId])
  @@index([playerId])
  @@index([teamId])
  @@map("game_player_stats")
}

model InjuryReport {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Détails de la blessure
  injuryType  String    // "Ankle Sprain", "Knee Soreness", etc.
  status      String    // "Out", "Day-To-Day", "Questionable", "Probable"
  description String?   // Description complète si disponible

  // Dates
  injuryDate  DateTime  // Date de la blessure
  returnDate  DateTime? // Date de retour estimée/réelle

  // Status
  isActive    Boolean   @default(true) // false si le joueur est revenu

  @@index([playerId])
  @@index([isActive])
  @@map("injury_reports")
}

model PlayerSeasonStats {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  season      String   // "2025-2026"

  // Games played
  gamesPlayed  Int
  gamesStarted Int?

  // Averages per game
  pointsPerGame      Float
  reboundsPerGame    Float
  assistsPerGame     Float
  stealsPerGame      Float?
  blocksPerGame      Float?
  turnoversPerGame   Float?
  minutesPerGame     Float?

  // Shooting percentages
  fieldGoalPct       Float?
  threePointPct      Float?
  freeThrowPct       Float?

  // Totals
  totalPoints        Int
  totalRebounds      Int
  totalAssists       Int
  totalSteals        Int?
  totalBlocks        Int?
  totalTurnovers     Int?
  totalMinutes       Int?

  // Shooting totals (calculated from GamePlayerStats)
  totalFGM           Int?    // Field goals made (2pt + 3pt)
  totalFGA           Int?    // Field goals attempted (2pt + 3pt)
  total3PM           Int?    // 3-pointers made
  total3PA           Int?    // 3-pointers attempted
  totalFTM           Int?    // Free throws made
  totalFTA           Int?    // Free throws attempted

  // Rebonds offensifs / défensifs
  offensiveReboundsPerGame Float?
  defensiveReboundsPerGame Float?
  totalOffensiveRebounds   Int?
  totalDefensiveRebounds   Int?

  // Per-game shooting counts (for leaders sorting)
  fgmPerGame         Float?   // Tirs réussis / match
  fgaPerGame         Float?   // Tirs tentés / match
  threePmPerGame     Float?   // 3 pts réussis / match
  threePaPerGame     Float?   // 3 pts tentés / match

  // Advanced stats
  plusMinus          Int?     // Season +/- (cumul)
  doubleDoubles      Int      @default(0)
  tripleDoubles      Int      @default(0)

  // Fautes et LF par match
  foulsPerGame       Float?   // Fautes personnelles / match
  ftmPerGame         Float?   // LF réussis / match
  ftaPerGame         Float?   // LF tentés / match

  @@unique([playerId, season])
  @@index([playerId])
  @@index([season])
  @@map("player_season_stats")
}

model TeamSeasonStats {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  season      String   // "2025-2026"

  // Record
  wins        Int
  losses      Int
  winPct      Float

  // Conference/Division standing
  conferenceRank Int?
  divisionRank   Int?

  // Averages per game
  pointsPerGame         Float
  pointsAllowedPerGame  Float
  pointDifferential     Float

  // Team shooting
  fieldGoalPct          Float?
  threePointPct         Float?
  freeThrowPct          Float?

  // Other averages
  reboundsPerGame       Float?
  assistsPerGame        Float?
  stealsPerGame         Float?
  blocksPerGame         Float?
  turnoversPerGame      Float?

  // Streaks
  currentStreak         String?  // "W3", "L2", etc.
  homeRecord            String?  // "15-5"
  awayRecord            String?  // "12-8"
  conferenceRecord      String?  // "20-10" (vs conference)
  divisionRecord        String?  // "8-4" (vs division)
  last10Record          String?  // "7-3" (last 10 games)

  @@unique([teamId, season])
  @@index([teamId])
  @@index([season])
  @@map("team_season_stats")
}

// ============================================
// PLAYOFF SERIES TRACKING
// ============================================

model PlayoffSeries {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  season      String
  // Unique key: "{season}-{abbr1}-{abbr2}" with abbrevs sorted alphabetically
  // e.g. "2025-26-BOS-NYK"
  seriesKey   String    @unique

  round       Int?      // 1=First Round, 2=Conf Semis, 3=Conf Finals, 4=Finals
  conference  String?   // "East", "West", "Finals"

  team1Id     String
  team1       Team      @relation("SeriesTeam1", fields: [team1Id], references: [id])
  team2Id     String
  team2       Team      @relation("SeriesTeam2", fields: [team2Id], references: [id])

  team1Wins   Int       @default(0)
  team2Wins   Int       @default(0)

  // Actual playoff seeds (post Play-In). Set by fix-playoff-seeds script.
  team1Seed   Int?
  team2Seed   Int?

  winnerId    String?   // Set when series is complete
  status      String    @default("ACTIVE") // "ACTIVE" | "COMPLETED"

  games       Game[]

  @@index([season])
  @@index([status])
  @@map("playoff_series")
}

// ============================================
// SPECIAL PREDICTIONS (hors matchs individuels)
// ============================================

// Types: "PRESEASON_NBA_CUP_CHAMPION" | "PRESEASON_MVP_SEASON" | "PRESEASON_NBA_STANDINGS"
//        | "PRESEASON_BRACKET"
//        | "POSTSEASON_PLAYIN" | "POSTSEASON_PLAYOFFS_R1" | "POSTSEASON_PLAYOFFS_R2"
//        | "POSTSEASON_PLAYOFFS_CF" | "POSTSEASON_PLAYOFFS_FINALS"
model SpecialPrediction {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  season       String   // "2025-26"
  type         String   // voir types ci-dessus

  // Payload flexible (teamId, playerId, bracket JSON, etc.)
  data         Json

  // Statut du pari
  status       String   @default("OPEN")  // "OPEN" | "LOCKED" | "GRADED"
  pointsEarned Int      @default(0)
  breakdown    Json?    // Détail du calcul des points

  @@unique([userId, type, season])
  @@index([userId])
  @@index([type, season])
  @@map("special_predictions")
}

// Cotes et barèmes par saison, par type, par entité (équipe ou joueur)
model SpecialPredictionConfig {
  id       String @id @default(uuid())
  season   String
  type     String  // "NBA_CUP_CHAMPION" | "MVP_SEASON" | "NBA_CHAMPION"
  entityId String  // teamId ou playerId
  points   Int     // Points si correct
  rank     Int?    // Classement de l'entité (pour tri/affichage)

  @@unique([season, type, entityId])
  @@index([season, type])
  @@map("special_prediction_configs")
}

// Vainqueurs des trophées, saisis dans l'admin (/admin/saison) pour noter les paris de début de saison.
// award : "MVP" | "DPOY" | "ROOKIE" | "FINALS_MVP"
model SeasonAwardResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season    String
  award     String
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([season, award])
  @@map("season_award_results")
}

// ============================================
// COMPETITION SEASONS (for leaderboard)
// ============================================

model CompetitionSeason {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  name          String
  slug          String    @unique
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean   @default(false)

  @@map("competition_seasons")
}


// ============================================
// SOCIAL FEATURES (Ligues privées & Amis)
// ============================================

model PrivateLeague {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  name        String
  slug        String         @unique
  description String?
  isPrivate   Boolean        @default(true)
  inviteCode  String?        @unique

  ownerId     String
  owner       User           @relation("LeagueOwner", fields: [ownerId], references: [id])

  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean        @default(true)

  members     LeagueMember[]

  @@map("private_leagues")
}

model LeagueMember {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  leagueId  String
  league    PrivateLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  isAdmin   Boolean       @default(false)
  joinedAt  DateTime      @default(now())

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
  @@map("league_members")
}

model FriendRequest {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  senderId   String
  sender     User     @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User     @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("friend_requests")
}

// ============================================
// ADMIN : historique des mises à jour et signalements
// ============================================

/// Un passage d'une tâche de mise à jour, déclenchée par un CRON ou depuis l'admin.
model CronRun {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())

  job        String   // "morning-update" | "update-injuries" | "refresh-night" | "reprocess-game" | "recalculate-standings"
  trigger    String   // "cron" | "admin"
  ok         Boolean
  durationMs Int
  summary    Json?    // compteurs affichés dans l'admin
  problems   String[]
  logs       String[]

  @@index([job, createdAt])
  @@map("cron_runs")
}

/// Signalement envoyé depuis le bouton « Signaler un bug ».
model BugReport {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  message   String
  page      String?
  userAgent String?
  screen    String?
  email     String?         // pour répondre : compte connecté ou e-mail saisi

  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  status    BugReportStatus @default(OPEN)

  @@index([status, createdAt])
  @@map("bug_reports")
}