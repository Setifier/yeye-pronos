# Copier en .env et remplir. Détail : docs/INSTALLATION.md · contrôle : npm run check:setup

# Base de données (Neon)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="longue-chaine-aleatoire"
BETTER_AUTH_URL="http://localhost:3000"       # URL de l'app sans / final (prod : https://…)
NEXT_PUBLIC_API_URL="http://localhost:3000"   # même valeur que BETTER_AUTH_URL

# Connexion Google (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mails (Gmail SMTP, mot de passe d'application)
NODEMAILER_USER="adresse@gmail.com"
NODEMAILER_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Admins (séparés par ;) : rôle admin à l'inscription + alertes du CRON
ADMIN_EMAILS="admin@example.com"

# Domaines e-mail acceptés en plus de la liste par défaut (séparés par ;)
ALLOWED_EMAIL_DOMAINS=""

# CRON Vercel (envoyé par Vercel en Authorization: Bearer)
CRON_SECRET="autre-chaine-aleatoire"

# Avatars (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
